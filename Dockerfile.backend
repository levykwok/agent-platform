FROM eclipse-temurin:17-jre-jammy

WORKDIR /app

# Prefer an explicit jar path; default matches local Maven output.
ARG JAR_FILE=target/agent-platform-0.1.0-SNAPSHOT.jar
COPY ${JAR_FILE} /app/app.jar

ENV AGENT_PLATFORM_WORKSPACE=/app/workspace
ENV JAVA_OPTS=""

EXPOSE 8080

CMD ["sh", "-c", "java $JAVA_OPTS -Dserver.port=8080 -jar /app/app.jar"]
